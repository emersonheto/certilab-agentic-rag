#!/usr/bin/env bash
set -euo pipefail

# ── Config ──────────────────────────────────────────────────────────────────
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${CERTILAB_RAG_ENV_FILE:-$ROOT_DIR/.env}"
API_PORT="${API_PORT:-8000}"
CHAT_PORT="${CHAT_PORT:-8001}"
QDRANT_PORT="${QDRANT_PORT:-6333}"
PHOENIX_PORT="${PHOENIX_PORT:-6006}"

PID_FILE="/tmp/certilab_dev_pids"
LOG_API="/tmp/certilab_api.log"
LOG_CHAT="/tmp/certilab_chat.log"
LOG_PHOENIX="/tmp/certilab_phoenix.log"

# ── Colores ─────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
DIM='\033[2m'; BOLD='\033[1m'; NC='\033[0m'
info()  { echo -e "${CYAN}▶ $*${NC}"; }
ok()    { echo -e "${GREEN}✓ $*${NC}"; }
warn()  { echo -e "${YELLOW}⚠ $*${NC}"; }
fail()  { echo -e "${RED}✗ $*${NC}"; exit 1; }

# ── Utilidades ──────────────────────────────────────────────────────────────
_is_running() { kill -0 "$1" 2>/dev/null; }

_port_up() { curl -sf "http://localhost:$1$2" >/dev/null 2>&1; }

_wait_port() {
    local port="$1" path="${2:-/}" tries="${3:-15}"
    for i in $(seq 1 "$tries"); do
        _port_up "$port" "$path" && return 0
        sleep 1
    done
    return 1
}

_read_pids()   { [[ -f "$PID_FILE" ]] && cat "$PID_FILE" || true; }
_save_pid()    { echo "$1" >> "$PID_FILE"; }
_clear_pids()  { rm -f "$PID_FILE"; }

# Kill any process holding a port, regardless of PID file state.
_kill_port() {
    local port="$1" pids
    pids=$(lsof -ti ":$port" 2>/dev/null || true)
    [[ -z "$pids" ]] && return 0
    echo "$pids" | xargs kill 2>/dev/null || true
    sleep 1
    # Force kill if still alive
    pids=$(lsof -ti ":$port" 2>/dev/null || true)
    [[ -n "$pids" ]] && echo "$pids" | xargs kill -9 2>/dev/null || true
}

# ── Comandos ────────────────────────────────────────────────────────────────

# ── Arranque/parada atómica por servicio ────────────────────────────────────

_start_qdrant() {
    info "Qdrant (Docker)..."
    docker compose -f "$ROOT_DIR/docker-compose.yml" up qdrant -d 2>/dev/null
    _wait_port "$QDRANT_PORT" "/healthz" 15 || fail "Qdrant no responde"
    ok "Qdrant → http://localhost:$QDRANT_PORT/dashboard"
}

_stop_qdrant() {
    docker compose -f "$ROOT_DIR/docker-compose.yml" stop qdrant 2>/dev/null || true
    ok "Qdrant detenido."
}

_start_phoenix() {
    info "Phoenix (trazabilidad)..."
    _kill_port "$PHOENIX_PORT"
    CERTILAB_RAG_ENV_FILE="$ENV_FILE" nohup uv run phoenix serve \
        --host 127.0.0.1 --port "$PHOENIX_PORT" > "$LOG_PHOENIX" 2>&1 &
    _save_pid $!
    _wait_port "$PHOENIX_PORT" "/" 8 && ok "Phoenix → http://localhost:$PHOENIX_PORT" \
        || warn "Phoenix no respondió (opcional)"
}

_stop_phoenix() {
    _kill_port "$PHOENIX_PORT"
    ok "Phoenix detenido."
}

_start_api() {
    info "API FastAPI..."
    _kill_port "$API_PORT"
    export CERTILAB_RAG_ENV_FILE="$ENV_FILE"
    nohup uv run uvicorn app.main:app --host 127.0.0.1 --port "$API_PORT" > "$LOG_API" 2>&1 &
    _save_pid $!
    _wait_port "$API_PORT" "/health" 10 || fail "API no responde"
    ok "API → http://localhost:$API_PORT/docs"
}

_stop_api() {
    _kill_port "$API_PORT"
    ok "API detenida."
}

_start_chat() {
    info "Chat (Chainlit)..."
    _kill_port "$CHAT_PORT"
    nohup uv run chainlit run ui/chainlit_app.py --port "$CHAT_PORT" --host 127.0.0.1 --headless > "$LOG_CHAT" 2>&1 &
    _save_pid $!
    _wait_port "$CHAT_PORT" "/" 10 && ok "Chat → http://localhost:$CHAT_PORT" \
        || warn "Chat tardó en iniciar"
}

_stop_chat() {
    _kill_port "$CHAT_PORT"
    ok "Chat detenido."
}

# ── Comandos ─────────────────────────────────────────────────────────────────

cmd_start() {
    local svc="${1:-all}"
    cd "$ROOT_DIR"

    if [[ "$svc" == "all" ]]; then
        info "Verificando dependencias..."
        command -v uv >/dev/null || fail "uv no está instalado."
        command -v docker >/dev/null || fail "Docker no está instalado."
        docker info >/dev/null 2>&1 || fail "Docker no está corriendo. Abrí Docker Desktop."
        [[ -f "$ENV_FILE" ]] || fail "No se encontró .env en $ENV_FILE"
        _clear_pids
        _start_qdrant
        _start_phoenix
        _start_api
        _start_chat
        _print_urls
        return
    fi

    [[ -f "$ENV_FILE" ]] || fail "No se encontró .env en $ENV_FILE"
    case "$svc" in
        qdrant)   command -v docker >/dev/null || fail "Docker no está instalado."
                  docker info >/dev/null 2>&1 || fail "Docker no está corriendo."
                  _start_qdrant ;;
        phoenix)  command -v uv >/dev/null || fail "uv no está instalado."
                  _start_phoenix ;;
        api)      command -v uv >/dev/null || fail "uv no está instalado."
                  _start_api ;;
        chat)     command -v uv >/dev/null || fail "uv no está instalado."
                  _start_chat ;;
        *)        fail "Servicio desconocido: $svc. Opciones: qdrant, phoenix, api, chat" ;;
    esac
}

cmd_stop() {
    local svc="${1:-all}"

    if [[ "$svc" == "all" ]]; then
        info "Deteniendo todos los servicios..."
        while read -r pid; do
            _is_running "$pid" && kill "$pid" 2>/dev/null || true
        done < <(_read_pids)
        _clear_pids
        _kill_port "$API_PORT"
        _kill_port "$CHAT_PORT"
        _kill_port "$PHOENIX_PORT"
        _stop_qdrant
        ok "Todo detenido."
        return
    fi

    case "$svc" in
        qdrant)  _stop_qdrant ;;
        phoenix) _stop_phoenix ;;
        api)     _stop_api ;;
        chat)    _stop_chat ;;
        *)       fail "Servicio desconocido: $svc. Opciones: qdrant, phoenix, api, chat" ;;
    esac
}

cmd_restart() {
    local svc="${1:-all}"
    cmd_stop "$svc"
    sleep 1
    cd "$ROOT_DIR"
    case "$svc" in
        all)     cmd_start "all" ;;
        qdrant)  _start_qdrant ;;
        phoenix) _start_phoenix ;;
        api)     _start_api ;;
        chat)    _start_chat ;;
        *)       fail "Servicio desconocido: $svc. Opciones: qdrant, phoenix, api, chat" ;;
    esac
}

cmd_status() {
    echo -e "${BOLD}Estado de servicios${NC}\n"

    # Qdrant
    if docker compose -f "$ROOT_DIR/docker-compose.yml" ps qdrant 2>/dev/null | grep -q "Up\|running"; then
        ok "Qdrant    :$QDRANT_PORT  (Docker)"
    else
        warn "Qdrant    :$QDRANT_PORT  (detenido)"
    fi

    # Phoenix
    if _port_up "$PHOENIX_PORT" "/"; then
        ok "Phoenix   :$PHOENIX_PORT"
    else
        warn "Phoenix   :$PHOENIX_PORT  (detenido)"
    fi

    # API
    if _port_up "$API_PORT" "/health"; then
        local mode
        mode=$(curl -sf "http://localhost:$API_PORT/health" 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('status','?'))" 2>/dev/null || echo "?")
        ok "API       :$API_PORT  ($mode)"
    else
        warn "API       :$API_PORT  (detenido)"
    fi

    # Chat
    if _port_up "$CHAT_PORT" "/"; then
        ok "Chat      :$CHAT_PORT"
    else
        warn "Chat      :$CHAT_PORT  (detenido)"
    fi
    echo ""
}

cmd_logs() {
    local svc="${1:-all}"
    case "$svc" in
        api|fastapi)
            tail -f "$LOG_API"
            ;;
        chat|chainlit)
            tail -f "$LOG_CHAT"
            ;;
        phoenix)
            tail -f "$LOG_PHOENIX"
            ;;
        qdrant)
            docker compose -f "$ROOT_DIR/docker-compose.yml" logs -f qdrant
            ;;
        all|"")
            info "Logs combinados (Ctrl+C para salir)..."
            tail -f "$LOG_API" "$LOG_CHAT" "$LOG_PHOENIX" 2>/dev/null \
                || warn "Algunos logs no existen todavía. Corré ./dev start primero."
            ;;
        *)
            fail "Servicio desconocido: $svc. Usa: api, chat, phoenix, qdrant, all"
            ;;
    esac
}

cmd_smoke() {
    info "Smoke test del pipeline..."
    cd "$ROOT_DIR"

    _port_up "$API_PORT" "/health" || fail "API no está corriendo. Ejecuta ./dev start"

    local mode
    mode=$(grep "^APP_MODE=" "$ENV_FILE" 2>/dev/null | cut -d= -f2 || echo "mock")
    info "Modo: $mode"

    local key_header=("-H" "X-Demo-Token: dummy")
    if [[ "$mode" == "real" ]]; then
        local admin_key
        admin_key=$(grep "^API_KEY_ADMIN=" "$ENV_FILE" 2>/dev/null | cut -d= -f2 || echo "")
        [[ -z "$admin_key" ]] && fail "API_KEY_ADMIN no configurado en .env"
        key_header=("-H" "X-API-Key: $admin_key")
    fi

    echo ""
    echo -e "${DIM}GET /health${NC}"
    curl -sf "http://localhost:$API_PORT/health" | python3 -m json.tool 2>/dev/null || warn "Health falló"

    echo ""
    echo -e "${DIM}POST /ask${NC}"
    curl -sf --max-time 60 -X POST "http://localhost:$API_PORT/ask" \
        -H 'Content-Type: application/json' \
        "${key_header[@]}" \
        -d '{"question":"¿qué certificados hay?"}' | python3 -m json.tool 2>/dev/null \
        || warn "/ask falló o timeout"

    echo ""
    ok "Smoke completo."
}

_print_urls() {
    echo ""
    echo -e "${GREEN}═══════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  ✅ Servicios levantados${NC}"
    echo -e "${GREEN}═══════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "  ${CYAN}Chat${NC}      http://localhost:$CHAT_PORT"
    echo -e "  ${CYAN}API${NC}       http://localhost:$API_PORT/docs"
    echo -e "  ${CYAN}Health${NC}    http://localhost:$API_PORT/health"
    echo -e "  ${CYAN}Qdrant${NC}    http://localhost:$QDRANT_PORT/dashboard"
    echo -e "  ${CYAN}Phoenix${NC}   http://localhost:$PHOENIX_PORT"
    echo ""
    echo -e "  ${DIM}./dev status   ver estado${NC}"
    echo -e "  ${DIM}./dev logs api  ver logs${NC}"
    echo -e "  ${DIM}./dev stop      detener${NC}"
    echo -e "  ${DIM}./dev smoke     probar /ask${NC}"
    echo ""
}

_print_help() {
    cat <<EOF
${BOLD}Certilab Agentic RAG — Dev Script${NC}

${CYAN}Uso:${NC}  ./dev <comando> [servicio]

${BOLD}Comandos:${NC}

  ${GREEN}start${NC}            Levanta todo (Qdrant + Phoenix + API + Chat)
  ${GREEN}start api${NC}        Levanta solo la API
  ${GREEN}start chat${NC}       Levanta solo el Chat
  ${GREEN}start phoenix${NC}    Levanta solo Phoenix
  ${GREEN}start qdrant${NC}     Levanta solo Qdrant

  ${GREEN}stop${NC}             Detiene todo
  ${GREEN}stop api${NC}         Detiene solo la API
  ${GREEN}stop chat${NC}        Detiene solo el Chat
  ${GREEN}stop phoenix${NC}     Detiene solo Phoenix
  ${GREEN}stop qdrant${NC}      Detiene solo Qdrant

  ${GREEN}restart${NC}          Reinicia todo
  ${GREEN}restart api${NC}      Reinicia solo la API
  ${GREEN}restart chat${NC}     Reinicia solo el Chat
  ${GREEN}restart phoenix${NC}  Reinicia solo Phoenix
  ${GREEN}restart qdrant${NC}   Reinicia solo Qdrant

  ${GREEN}status${NC}           Muestra qué está corriendo y en qué puerto
  ${GREEN}smoke${NC}            Prueba /health y /ask rápidamente
  ${GREEN}logs${NC}             Ver logs combinados (tail -f)
  ${GREEN}logs api${NC}         Ver solo logs de la API
  ${GREEN}logs chat${NC}        Ver solo logs del Chat
  ${GREEN}logs phoenix${NC}     Ver solo logs de Phoenix
  ${GREEN}logs qdrant${NC}      Ver solo logs de Qdrant
  ${GREEN}help${NC}             Esta ayuda

${BOLD}Variables opcionales:${NC}
  API_PORT, CHAT_PORT, QDRANT_PORT, PHOENIX_PORT, CERTILAB_RAG_ENV_FILE

EOF
}

# ── Dispatch ────────────────────────────────────────────────────────────────
case "${1:-help}" in
    start|up)       cmd_start "${2:-all}" ;;
    stop|down)      cmd_stop "${2:-all}" ;;
    restart)        cmd_restart "${2:-all}" ;;
    status|ps)      cmd_status ;;
    smoke|test)     cmd_smoke ;;
    logs|log)       cmd_logs "${2:-all}" ;;
    help|--help|-h) _print_help ;;
    *)              fail "Comando desconocido: $1\nEjecuta ./dev help" ;;
esac
